# Copy this file to .env and fill in your key locally. Do not share .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.chatanywhere.tech/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
# 0 disables the cumulative request cap; logging and concurrency limits remain.
SLEEPLENS_REQUEST_LIMIT=0
SLEEPLENS_MAX_CONCURRENT=2
SLEEPLENS_MAX_INPUT_CHARS=120000
SLEEPLENS_BUDGET_DB=.state/llm-usage.sqlite3
SLEEPLENS_SHARE_MODE=0
SLEEPLENS_SHARE_PASSWORD=
SLEEPLENS_SHARE_LOG_DAYS=7
